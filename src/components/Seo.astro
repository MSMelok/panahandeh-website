---
/**
 * SEO + GEO head block.
 *
 * SEO is about being found. GEO — Generative Engine Optimisation — is about being
 * *citable*: an AI answer engine reading this page should be able to state a fact
 * about Panahandeh and attribute it. That wants unambiguous entity definitions,
 * explicit structured data, and prose that states facts plainly rather than
 * gesturing at them. Both are served by the same thing: say true things clearly,
 * in HTML, on the server.
 */
import { SITE, type Lang } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path without language prefix, e.g. '/products/saffron'. */
  path: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  /** Extra JSON-LD graph nodes for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title, description, lang, path,
  image = '/assets/pack-gift.webp',
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

const base = SITE.url.replace(/\/$/, '');
const clean = path === '/' ? '' : path.replace(/\/$/, '');

/* One URL per language for the same page. hreflang has to name every alternate
   INCLUDING the page it sits on, so this map is both the canonical and the
   alternate list — they cannot drift apart. */
const ALT: Record<Lang, string> = {
  en: `${base}${clean || '/'}`,
  fa: `${base}/fa${clean}`,
  ar: `${base}/ar${clean}`,
};
const canonical = ALT[lang];

/* Facebook/LinkedIn locale codes. Persian is read from Iran, Arabic from the Gulf —
   the site is written for a UAE exporter, so ar_AE rather than ar_AR. */
const OG_LOCALE: Record<Lang, string> = { en: 'en_AE', fa: 'fa_IR', ar: 'ar_AE' };
const HTML_LOCALE: Record<Lang, string> = { en: 'en-AE', fa: 'fa-IR', ar: 'ar-AE' };
const OTHER_LANGS = (['en', 'fa', 'ar'] as const).filter((l) => l !== lang);

const ogImage = image.startsWith('http') ? image : `${base}${image}`;
const fullTitle = `${title} | ${SITE.legalName}`;

/* The Organization node is the anchor for every other entity on the site. Answer
   engines resolve "who is Panahandeh" from this, so it carries the disambiguating
   detail: legal name, the brand it owns, where it operates, what it deals in. */
const organization = {
  '@type': 'Organization',
  '@id': `${base}/#organization`,
  name: SITE.legalName,
  alternateName: SITE.shortName,
  url: base,
  email: SITE.email,
  telephone: SITE.phone,
  description:
    'Panahandeh Foodstuff Trading L.L.C is a Dubai-based trading house that sources saffron, rice, pulses, beans and spices at origin and exports them through Jebel Ali under its own RAVOMA brand.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.locality,
    addressCountry: SITE.address.country,
  },
  areaServed: [
    'GCC', 'South Asia', 'East Africa', 'Europe', 'United Kingdom', 'North America',
  ],
  brand: { '@type': 'Brand', name: SITE.brand, slogan: SITE.tagline },
  knowsLanguage: ['en', 'fa', 'ar'],
};

const website = {
  '@type': 'WebSite',
  '@id': `${base}/#website`,
  url: base,
  name: SITE.legalName,
  publisher: { '@id': `${base}/#organization` },
  inLanguage: HTML_LOCALE[lang],
};

const graph = { '@context': 'https://schema.org', '@graph': [organization, website, ...schema] };

/* Arabic copy carries U+2066/U+2069 isolates so numeric ranges do not reverse on screen
   (see digits() in data/i18n.ts). Those are display controls: a crawler reading
   "\u2066٣\u2069–\u2066٧\u2069" as a value gets invisible junk in its index. The visible
   page keeps them; the structured data does not. */
const BIDI_CONTROLS = /[\u2066-\u2069\u202A-\u202E\u200E\u200F]/g;
const stripBidi = (v: unknown): unknown =>
  typeof v === 'string' ? v.replace(BIDI_CONTROLS, '')
  : Array.isArray(v) ? v.map(stripBidi)
  : v && typeof v === 'object'
    ? Object.fromEntries(Object.entries(v as Record<string, unknown>).map(([k, x]) => [k, stripBidi(x)]))
    : v;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="alternate" hreflang="en" href={ALT.en} />
<link rel="alternate" hreflang="fa" href={ALT.fa} />
<link rel="alternate" hreflang="ar" href={ALT.ar} />
<link rel="alternate" hreflang="x-default" href={ALT.en} />

<meta property="og:type" content={type === 'product' ? 'website' : type} />
<meta property="og:site_name" content={SITE.legalName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{OTHER_LANGS.map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0C0B0A" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* Tajawal (UI) and Amiri (display) are requested only on the Arabic pages. They are
    two more families over the wire and nothing outside html[lang='ar'] asks for them,
    so loading them everywhere would cost every English reader two unused downloads.

    Two things were dropped after an audit of what the pages actually use: Gulzar, which
    was fetched on all 45 pages while the Persian display line is set in Vazirmatn, and
    Cormorant's italic axis, which nothing on the site asks for. Vazirmatn stays on the
    English pages on purpose — the product cards print each name in the other language. */}
<link
  rel="stylesheet"
  href={`https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Jost:wght@300;400;500;600&family=Vazirmatn:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500${lang === 'ar' ? '&family=Tajawal:wght@300;400;500;700&family=Amiri:wght@400;700' : ''}&display=swap`}
/>

<script type="application/ld+json" set:html={JSON.stringify(stripBidi(graph))} is:inline />
