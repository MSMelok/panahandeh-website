---
/**
 * A section's ornament ground.
 *
 * The landing page proved the tuning: a tessellation at 0.075 reads as texture
 * without competing, a field at 0.06 disappears politely under body copy, the
 * half-medallion tops out at 0.15 away from text and 0.22 behind it, and a rail
 * can run brighter because nothing sits on top of it.
 *
 * Those numbers live here rather than in seven page stylesheets, so a change to
 * the ornament's weight is one edit and cannot drift between pages. The host
 * section needs `class="... has-ground"` (see tokens.css) to establish the
 * positioning context and clip the overflow.
 */
import Field from './Field.astro';
import TilePattern from './TilePattern.astro';
import Shamsa from './Shamsa.astro';
import BorderRail from './BorderRail.astro';

interface Props {
  kind: 'field' | 'tile' | 'medallion' | 'rail';
  /** Which edge a medallion or rail anchors to. Logical, so it mirrors for RTL. */
  side?: 'start' | 'end';
  /** Rail only: which block edge it sits on. */
  edge?: 'start' | 'end';
  /** Override the tuned opacity. Raise it only after measuring the render. */
  strength?: number;
  /** Tile/field cell size in px. Smaller reads busier. */
  size?: number;
  class?: string;
}

const { kind, side = 'start', edge = 'end', strength, size, class: className } = Astro.props;

const DEFAULT_OPACITY: Record<Props['kind'], number> = {
  field: 0.06,
  tile: 0.075,
  medallion: 0.15,
  rail: 0.28,
};

const opacity = strength ?? DEFAULT_OPACITY[kind];
---

<div
  class:list={['pg-ground', `is-${kind}`, `at-${side}`, kind === 'rail' && `edge-${edge}`, className]}
  style={`--pg-ground-o:${opacity}`}
  aria-hidden="true"
>
  {kind === 'field' && <Field size={size ?? 300} weight={1.3} />}
  {kind === 'tile' && <TilePattern size={size ?? 228} />}
  {kind === 'medallion' && <Shamsa half rings={5} />}
  {kind === 'rail' && <BorderRail height={26} />}
</div>

<style>
  .pg-ground {
    position: absolute;
    z-index: -1;
    color: var(--ornament);
    opacity: var(--pg-ground-o);
    pointer-events: none;
  }

  /* Full-bleed textures fade downward so the section's lower edge never ends on a
     hard crop of the pattern. */
  .is-field,
  .is-tile {
    inset: 0;
  }
  .is-field {
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.35) 62%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.35) 62%, transparent 100%);
  }
  .is-tile {
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 26%, rgba(0, 0, 0, 0.4) 74%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 26%, rgba(0, 0, 0, 0.4) 74%, transparent 100%);
  }

  /* The medallion is a half-disc whose flat side sits against one edge. Anchoring
     to the inline end needs the mirror, otherwise the flat side faces inward. */
  .is-medallion {
    inset-block-start: 50%;
    block-size: min(880px, 112%);
    aspect-ratio: 1 / 2;
  }
  .is-medallion.at-start {
    inset-inline-start: 0;
    transform: translateY(-50%);
    -webkit-mask-image: radial-gradient(112% 86% at 0% 50%, #000 0%, #000 42%, rgba(0, 0, 0, 0.45) 72%, transparent 96%);
    mask-image: radial-gradient(112% 86% at 0% 50%, #000 0%, #000 42%, rgba(0, 0, 0, 0.45) 72%, transparent 96%);
  }
  .is-medallion.at-end {
    inset-inline-end: 0;
    transform: translateY(-50%) scaleX(-1);
    -webkit-mask-image: radial-gradient(112% 86% at 0% 50%, #000 0%, #000 42%, rgba(0, 0, 0, 0.45) 72%, transparent 96%);
    mask-image: radial-gradient(112% 86% at 0% 50%, #000 0%, #000 42%, rgba(0, 0, 0, 0.45) 72%, transparent 96%);
  }

  .is-rail {
    inset-inline: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  .is-rail.edge-end {
    inset-block-end: 0;
  }
  .is-rail.edge-start {
    inset-block-start: 0;
  }
</style>
