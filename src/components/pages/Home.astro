---
/**
 * Home.
 *
 * Content lives here once; /index.astro and /fa/index.astro are thin wrappers that
 * pass `lang`. Every string comes from t() or from the fa/Fa fields on the data
 * objects — there is no second copy of this markup to keep in sync.
 *
 * The page states the availability position plainly and early: saffron and rice ship
 * today, seven further lines follow. Presenting nine lines identically would overstate
 * the range, and a buyer who enquires about chickpeas and is told they do not exist
 * yet does not come back.
 *
 * Ornament: the pointed-arch niche and the radiating shamsa, both from
 * components/ornament. The shamsa is the client's own watermark
 * (brand/newPattern01.jpeg) — a half medallion anchored on the reading edge,
 * masked so its density falls away before it reaches the lede and the buttons.
 */
import { TRANSIT, type Lang } from '../../data/site';
import { LIVE_PRODUCTS, PRODUCTS, ORIGINS, PACK_FORMATS } from '../../data/products';
import { t, href, digits, type Key } from '../../data/i18n';
import Arch from '../ornament/Arch.astro';
import Shamsa from '../ornament/Shamsa.astro';
import Field from '../ornament/Field.astro';
import LineElement from '../ornament/LineElement.astro';
import BorderRail from '../ornament/BorderRail.astro';
import TilePattern from '../ornament/TilePattern.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fa = lang === 'fa';
/* Pick a per-language value. Written out rather than left as the `fa ? x : y`
   ternaries this replaced, because those silently yielded English for Arabic. */
const pick3 = <T,>(en: T, faV: T, ar: T): T => (lang === 'fa' ? faV : lang === 'ar' ? ar : en);

/* The counter-script line under the headline: Persian on the English page, Latin on
   the Persian one. It needs its own lang/dir or the browser shapes it with the wrong
   font and, in the Latin case, draws it into the RTL paragraph direction. */
const counterLang = lang === 'en' ? 'fa' : 'en';
const counterDir = counterLang === 'fa' ? 'rtl' : 'ltr';

/* Every figure is derived from the data files, never typed in. If a line is added to
   products.ts the stat row moves with it. */
const STATS: { n: number; k: Key }[] = [
  { n: PRODUCTS.length, k: 'stat.lines' },
  { n: LIVE_PRODUCTS.length, k: 'stat.live' },
  { n: ORIGINS.length, k: 'stat.origins' },
  { n: TRANSIT.length, k: 'stat.markets' },
  { n: PACK_FORMATS.length, k: 'stat.formats' },
];

const FLOW: { t: Key; b: Key }[] = [
  { t: 'flow.1', b: 'flow.1.b' },
  { t: 'flow.2', b: 'flow.2.b' },
  { t: 'flow.3', b: 'flow.3.b' },
  { t: 'flow.4', b: 'flow.4.b' },
];
---

<!-- ============================ HERO ============================ -->
<section class="hero">
  <div class="hero-orn" aria-hidden="true"><Shamsa half /></div>

  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="label kick"><i aria-hidden="true"></i>{t('home.kicker', lang)}</p>

      <h1 class="display d1 hero-h1">
        {t('home.h1a', lang)}<br /><span class="acc">{t('home.h1b', lang)}</span>
      </h1>

      {/* The block keeps the page direction so it stays on the reading edge; the <bdi>
          isolates the opposite-script run inside it. Putting dir on the block instead
          would push the line to the far edge of the column. */}
      <p class="counter">
        <bdi lang={counterLang} dir={counterDir}>{t('home.counter', lang)}</bdi>
      </p>

      <div class="grule" aria-hidden="true"><LineElement /></div>

      <p class="lede hero-lede">{t('home.lede', lang)}</p>

      <div class="ctas">
        <a class="btn" href={href('/products', lang)}>{t('cta.products', lang)}</a>
        <a class="btn ghost" href={href('/contact', lang)}>{t('cta.quote', lang)}</a>
      </div>
    </div>

    <Arch class="hero-arch" ratio="3 / 4.3">
      <img
        src="/assets/saffron.webp"
        width="900"
        height="1200"
        fetchpriority="high"
        decoding="async"
        alt={t('home.alt.stigmas', lang)}
      />
    </Arch>
  </div>
</section>

<!-- ============================ STATS ============================ -->
<div class="stats">
  <div class="stats-orn" aria-hidden="true"><BorderRail height={26} /></div>
  <div class="wrap stats-in">
    {
      STATS.map((s) => (
        <div class="stat">
          <span class="sv">{digits(s.n, lang)}</span>
          <span class="sl">{t(s.k, lang)}</span>
        </div>
      ))
    }
  </div>
</div>

<!-- ======================= SHIPPING TODAY ======================= -->
<section class="sec now">
  <div class="now-orn" aria-hidden="true"><TilePattern size={228} /></div>
  <div class="wrap">
    <div class="sec-head">
      <p class="label kick"><i aria-hidden="true"></i>{t('home.now.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('home.now.h1', lang)}<br /><span class="acc">{t('home.now.h2', lang)}</span>
      </h2>
      <p class="lede">{t('home.now.p', lang)}</p>
    </div>

    <div class="now-grid">
      {
        LIVE_PRODUCTS.map((p) => (
          <article class="line">
            <a class="line-fig" href={href(`/products/${p.slug}`, lang)} tabindex="-1" aria-hidden="true">
              <Arch as="span">
                <img
                  src={`/assets/${p.img}.webp`}
                  width="900"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                  alt=""
                />
              </Arch>
            </a>

            <div class="line-body">
              <p class="tag live">
                <i aria-hidden="true" />
                {t('status.live', lang)}
              </p>

              <h3 class="display d3 line-name">
                <a href={href(`/products/${p.slug}`, lang)}>{pick3(p.en, p.fa, p.ar)}</a>
              </h3>
              <p class="counter sm">
                <bdi lang={counterLang} dir={counterDir}>{(lang === 'en' ? p.fa : p.en)}</bdi>
              </p>

              <dl class="kv">
                <div>
                  <dt>{t('label.grade', lang)}</dt>
                  <dd>{pick3(p.grade, p.gradeFa, p.gradeAr)}</dd>
                </div>
                <div>
                  <dt>{t('label.format', lang)}</dt>
                  <dd>
                    <bdi dir="ltr">{p.formats.join(' · ')}</bdi>
                  </dd>
                </div>
              </dl>

              <a class="inline-cta" href={href(`/products/${p.slug}`, lang)}>
                {t('cta.line', lang)}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4.5 12h15" />
                  <path d="m13 5.5 6.5 6.5-6.5 6.5" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="all-link">
      <a class="inline-cta" href={href('/products', lang)}>
        {t('cta.all', lang)}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4.5 12h15"></path>
          <path d="m13 5.5 6.5 6.5-6.5 6.5"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<!-- ========================= WHAT WE DO ========================= -->
<section class="sec do">
  <div class="do-orn" aria-hidden="true"><Field size={300} weight={1.3} /></div>

  <div class="wrap do-in">
    <div class="do-copy">
      <p class="label kick"><i aria-hidden="true"></i>{t('home.do.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('home.do.h1', lang)}<br /><span class="acc">{t('home.do.h2', lang)}</span>
      </h2>
      <p class="lede">{t('home.do.p', lang)}</p>
      <p class="do-cta">
        <a class="inline-cta" href={href('/about', lang)}>
          {t('cta.about', lang)}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4.5 12h15"></path>
            <path d="m13 5.5 6.5 6.5-6.5 6.5"></path>
          </svg>
        </a>
      </p>
    </div>

    <ol class="flow">
      {
        FLOW.map((f, i) => (
          <li>
            <span class="fn">{digits(String(i + 1).padStart(2, '0'), lang)}</span>
            <span class="ft">{t(f.t, lang)}</span>
            <span class="fb">{t(f.b, lang)}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ========================== ORIGINS =========================== -->
<section class="sec origins">
  <div class="origins-orn" aria-hidden="true"><Shamsa half rings={5} /></div>
  <div class="wrap">
    <div class="sec-head">
      <p class="label kick"><i aria-hidden="true"></i>{t('origins.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('origins.h1', lang)}<br /><span class="acc">{t('origins.h2', lang)}</span>
      </h2>
      <p class="lede">{t('origins.p', lang)}</p>
    </div>

    <ul class="ogrid">
      {
        ORIGINS.map((o) => (
          <li class="ocity">
            <span class="oc display">{pick3(o.en, o.fa, o.ar)}</span>
            <span class="of">
              <bdi lang={counterLang} dir={counterDir}>{(lang === 'en' ? o.fa : o.en)}</bdi>
            </span>
            <span class="op">{pick3(o.pEn, o.pFa, o.pAr)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ========================== CLOSING =========================== -->
<section class="close">
  <img
    class="close-bg"
    src="/assets/band.webp"
    width="2400"
    height="1000"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="close-rail" aria-hidden="true"><BorderRail height={34} /></div>

  <div class="wrap">
    {/* The measure lives on this inner block, never on .wrap — .wrap carries
        margin-inline:auto, so narrowing it centres the column instead of holding
        it on the reading edge. */}
    <div class="close-in">
      <p class="label kick"><i aria-hidden="true"></i>{t('close.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('close.h1', lang)} <span class="acc">{t('close.h2', lang)}</span>
      </h2>
      <p class="lede close-lede">{t('close.p', lang)}</p>
      <div class="ctas">
        <a class="btn" href={href('/contact', lang)}>{t('cta.quote', lang)}</a>
        <a class="btn ghost" href={href('/products', lang)}>{t('cta.all', lang)}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------- shared */
  .sec {
    padding-block: var(--rhythm);
  }

  /* Every band on the landing page carries ornament, and no two neighbours carry the
     same kind: medallion, tessellation, field, medallion again, rail. Each layer is
     -1 in its own stacking context, so content never has to out-specify it. */
  .now,
  .origins {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .now-orn {
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--gold);
    /* Quieter than the field on .do — this band already carries product photography,
       and a tessellation at full strength competes with it. */
    opacity: 0.075;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 26%, rgba(0, 0, 0, 0.4) 74%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 26%, rgba(0, 0, 0, 0.4) 74%, transparent 100%);
  }

  .origins-orn {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    z-index: -1;
    block-size: min(880px, 112%);
    aspect-ratio: 1 / 2;
    /* The hero anchors its half-medallion to the inline start; this one answers from
       the opposite edge, so the page reads as a spread rather than a repeat. The
       mirror is what puts the flat side against that edge. */
    transform: translateY(-50%) scaleX(-1);
    color: var(--gold);
    opacity: 0.15;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(112% 86% at 0% 50%, #000 0%, #000 42%, rgba(0, 0, 0, 0.45) 72%, transparent 96%);
    mask-image: radial-gradient(112% 86% at 0% 50%, #000 0%, #000 42%, rgba(0, 0, 0, 0.45) 72%, transparent 96%);
  }


  .sec-head {
    max-inline-size: 62ch;
    margin-block-end: clamp(40px, 4.6vw, 66px);
  }
  .sec-h {
    margin-block-start: 20px;
  }
  .sec-head .lede {
    margin-block-start: 22px;
  }

  /* A hairline that belongs to the label, drawn in solid gold. Gold is only ever used
     at full opacity here — at 75-80% it drops to 4.09:1 on obsidian and fails. */
  .kick i {
    display: block;
    inline-size: 26px;
    block-size: 1px;
    background: currentColor;
    flex: none;
  }

  /* the board's line element — tapering rule, arrow terminals, centre rosette */
  .grule {
    margin-block-start: 26px;
    color: var(--gold);
  }

  /* the counter-script echo — Persian under English, Latin under Persian */
  .counter {
    margin: 16px 0 0;
    font-family: var(--font-fa);
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    font-weight: 400;
    line-height: 1.8;
    color: var(--gold-light);
  }
  :global(html[lang='fa']) .counter {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
:global(html[lang='ar']) .counter {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .counter.sm {
    font-size: 1.05rem;
    margin-block-start: 6px;
    line-height: 1.6;
  }

  /* ---------------------------------------------------------------- buttons */
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-block-start: 36px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 15px 28px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--obsidian-deep);
    background: var(--gold);
    border: 1px solid var(--gold);
    transition: color 0.4s var(--snap);
  }
  :global(html[lang='fa']) .btn {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .btn {
    font-family: var(--font-ar);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--obsidian-deep);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--snap);
  }
  .btn:hover::after {
    transform: scaleY(1);
  }
  .btn:hover {
    color: var(--gold);
  }
  .btn.ghost {
    background: transparent;
    color: var(--ivory);
  }
  .btn.ghost::after {
    background: var(--gold);
  }
  .btn.ghost:hover {
    color: var(--obsidian-deep);
  }

  .inline-cta {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    padding-block: 6px;
    border-block-end: 1px solid var(--hair-strong);
    transition: color 0.3s var(--snap), border-color 0.3s var(--snap);
  }
  :global(html[lang='fa']) .inline-cta {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .inline-cta {
    font-family: var(--font-ar);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .inline-cta:hover {
    color: var(--gold-pale);
    border-block-end-color: var(--gold);
  }
  .inline-cta svg {
    inline-size: 15px;
    block-size: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  :global(html[dir='rtl']) .inline-cta svg {
    transform: scaleX(-1);
  }

  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(44px, 6vw, 88px) clamp(52px, 7vw, 100px);
    overflow: hidden;
  }

  /* The shamsa watermark. Its centre sits on the reading edge, so what falls on
     the page is the outer, airier half of the medallion — which is how the
     client's own artwork is cropped. The mask holds it at full strength for the
     first third and takes it to nothing before the lede and the buttons; the
     ornament is illumination behind the display line, never texture under body
     copy. Mirrored rather than repositioned in RTL: every radial band is
     symmetric about its own ray and the ray angles are closed under reflection,
     so the flipped figure is the same figure. */
  .hero-orn {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    z-index: -1;
    block-size: min(1180px, 122%);
    aspect-ratio: 1 / 2;
    transform: translateY(-50%);
    transform-origin: center;
    color: var(--gold);
    /* 0.22 is the ceiling, measured off the render rather than the token: the
       brightest ornament pixel then sits at #302718, where the 11px gold kicker
       label still measures 4.60:1. At 0.24 it drops to 4.47:1 and fails AA. */
    opacity: 0.22;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      118% 88% at 0% 50%,
      #000 0%,
      #000 44%,
      rgba(0, 0, 0, 0.5) 72%,
      transparent 96%
    );
    mask-image: radial-gradient(
      118% 88% at 0% 50%,
      #000 0%,
      #000 44%,
      rgba(0, 0, 0, 0.5) 72%,
      transparent 96%
    );
  }
  :global(html[dir='rtl']) .hero-orn {
    transform: translateY(-50%) scaleX(-1);
  }
  .hero-orn > :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .hero-in {
    position: relative;
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-in {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(48px, 5vw, 84px);
    }
  }
  .hero-h1 {
    margin-block-start: 22px;
  }
  .hero-lede {
    margin-block-start: 24px;
  }
  :global(.hero-arch) {
    inline-size: min(340px, 78vw);
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    :global(.hero-arch) {
      inline-size: min(420px, 100%);
      margin-inline: 0;
    }
  }

  /* ---------------------------------------------------------------- stats */
  .stats {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-block: 1px solid var(--hair);
    background: var(--surface);
  }
  /* A rail rather than a medallion: this band is a single row of figures, and a
     horizontal element is the one that belongs under a horizontal reading. */
  .stats-orn {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: -1;
    color: var(--gold);
    /* No text sits over this one — it runs under the figures, not behind them — so it
       can carry more than the 0.22 ceiling the medallion answers to. */
    opacity: 0.28;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  .stats-in {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .stats-in {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .stats-in {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .stat {
    display: grid;
    gap: 10px;
    padding-block: clamp(26px, 3vw, 40px);
    padding-inline-end: 20px;
    border-block-start: 1px solid var(--hair-ivory);
  }
  .stats-in .stat:nth-child(1),
  .stats-in .stat:nth-child(2) {
    border-block-start: 0;
  }
  @media (min-width: 640px) {
    .stats-in .stat:nth-child(3) {
      border-block-start: 0;
    }
  }
  @media (min-width: 1000px) {
    .stat {
      border-block-start: 0;
    }
  }
  .sv {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 3.1rem);
    font-weight: 600;
    line-height: 1;
    color: var(--gold-light);
  }
  :global(html[lang='fa']) .sv {
    font-family: var(--font-fa);
    font-weight: 600;
  }
:global(html[lang='ar']) .sv {
    font-family: var(--font-ar);
    font-weight: 600;
  }
  .sl {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  :global(html[lang='fa']) .sl {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .sl {
    font-family: var(--font-ar);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }

  /* ------------------------------------------------------- shipping today */
  .now-grid {
    display: grid;
    gap: clamp(30px, 3.4vw, 44px);
  }
  @media (min-width: 900px) {
    .now-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .line {
    display: grid;
    gap: 26px;
    align-content: start;
    padding: clamp(22px, 2.4vw, 32px);
    border: 1px solid var(--hair);
    background: var(--surface);
    transition: border-color 0.4s var(--snap), background-color 0.4s var(--snap);
  }
  @media (min-width: 560px) {
    .line {
      grid-template-columns: 190px minmax(0, 1fr);
      gap: clamp(24px, 2.6vw, 36px);
      align-items: start;
    }
  }
  .line:hover {
    border-color: var(--hair-strong);
    background: var(--obsidian-900);
  }
  .line:hover :global(.pg-arch-in img) {
    transform: scale(1.045);
  }

  .line-fig {
    display: block;
    position: relative;
    inline-size: min(190px, 60%);
  }
