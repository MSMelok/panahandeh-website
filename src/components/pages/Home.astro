---
/**
 * Home.
 *
 * Content lives here once; /index.astro and /fa/index.astro are thin wrappers that
 * pass `lang`. Every string comes from t() or from the fa/Fa fields on the data
 * objects — there is no second copy of this markup to keep in sync.
 *
 * The page states the availability position plainly and early: saffron and rice ship
 * today, seven further lines follow. Presenting nine lines identically would overstate
 * the range, and a buyer who enquires about chickpeas and is told they do not exist
 * yet does not come back.
 *
 * Ornament: the pointed-arch niche from the shipped v3 page, carried onto the obsidian
 * ground. The clip path is declared once at the top of the component with
 * clipPathUnits="objectBoundingBox" so a single definition scales to every frame.
 */
import { TRANSIT, type Lang } from '../../data/site';
import { LIVE_PRODUCTS, PRODUCTS, ORIGINS, PACK_FORMATS } from '../../data/products';
import { t, href, digits, type Key } from '../../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fa = lang === 'fa';

/* The counter-script line under the headline: Persian on the English page, Latin on
   the Persian one. It needs its own lang/dir or the browser shapes it with the wrong
   font and, in the Latin case, draws it into the RTL paragraph direction. */
const counterLang = fa ? 'en' : 'fa';
const counterDir = fa ? 'ltr' : 'rtl';

/* Every figure is derived from the data files, never typed in. If a line is added to
   products.ts the stat row moves with it. */
const STATS: { n: number; k: Key }[] = [
  { n: PRODUCTS.length, k: 'stat.lines' },
  { n: LIVE_PRODUCTS.length, k: 'stat.live' },
  { n: ORIGINS.length, k: 'stat.origins' },
  { n: TRANSIT.length, k: 'stat.markets' },
  { n: PACK_FORMATS.length, k: 'stat.formats' },
];

const FLOW: { t: Key; b: Key }[] = [
  { t: 'flow.1', b: 'flow.1.b' },
  { t: 'flow.2', b: 'flow.2.b' },
  { t: 'flow.3', b: 'flow.3.b' },
  { t: 'flow.4', b: 'flow.4.b' },
];

const ARCH = 'M0,100 V46 C0,29 13,13.5 35,5.5 C43,2.5 47.5,0.8 50,0 C52.5,0.8 57,2.5 65,5.5 C87,13.5 100,29 100,46 V100';
---

<svg width="0" height="0" class="defs" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="pgArch" clipPathUnits="objectBoundingBox">
      <path
        d="M0,1 V0.46 C0,0.29 0.13,0.135 0.35,0.055 C0.43,0.025 0.475,0.008 0.5,0 C0.525,0.008 0.57,0.025 0.65,0.055 C0.87,0.135 1,0.29 1,0.46 V1 Z"
      ></path>
    </clipPath>
  </defs>
</svg>

<!-- ============================ HERO ============================ -->
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="label kick"><i aria-hidden="true"></i>{t('home.kicker', lang)}</p>

      <h1 class="display d1 hero-h1">
        {t('home.h1a', lang)}<br /><span class="acc">{t('home.h1b', lang)}</span>
      </h1>

      {/* The block keeps the page direction so it stays on the reading edge; the <bdi>
          isolates the opposite-script run inside it. Putting dir on the block instead
          would push the line to the far edge of the column. */}
      <p class="counter">
        <bdi lang={counterLang} dir={counterDir}>{t('home.counter', lang)}</bdi>
      </p>

      <div class="grule" aria-hidden="true"><i></i><i></i><i></i></div>

      <p class="lede hero-lede">{t('home.lede', lang)}</p>

      <div class="ctas">
        <a class="btn" href={href('/products', lang)}>{t('cta.products', lang)}</a>
        <a class="btn ghost" href={href('/contact', lang)}>{t('cta.quote', lang)}</a>
      </div>
    </div>

    <figure class="arch hero-arch">
      <div class="arch-in">
        <img
          src="/assets/saffron.webp"
          width="900"
          height="1200"
          fetchpriority="high"
          decoding="async"
          alt={fa ? 'کلاله‌های زعفران' : 'Saffron stigmas'}
        />
      </div>
      <svg class="arch-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d={ARCH}></path>
      </svg>
    </figure>
  </div>
</section>

<!-- ============================ STATS ============================ -->
<div class="stats">
  <div class="wrap stats-in">
    {
      STATS.map((s) => (
        <div class="stat">
          <span class="sv">{digits(s.n, lang)}</span>
          <span class="sl">{t(s.k, lang)}</span>
        </div>
      ))
    }
  </div>
</div>

<!-- ======================= SHIPPING TODAY ======================= -->
<section class="sec now">
  <div class="wrap">
    <div class="sec-head">
      <p class="label kick"><i aria-hidden="true"></i>{t('home.now.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('home.now.h1', lang)}<br /><span class="acc">{t('home.now.h2', lang)}</span>
      </h2>
      <p class="lede">{t('home.now.p', lang)}</p>
    </div>

    <div class="now-grid">
      {
        LIVE_PRODUCTS.map((p) => (
          <article class="line">
            <a class="line-fig" href={href(`/products/${p.slug}`, lang)} tabindex="-1" aria-hidden="true">
              <div class="arch-in">
                <img
                  src={`/assets/${p.img}.webp`}
                  width="900"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                  alt=""
                />
              </div>
              <svg class="arch-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path d={ARCH} />
              </svg>
            </a>

            <div class="line-body">
              <p class="tag live">
                <i aria-hidden="true" />
                {t('status.live', lang)}
              </p>

              <h3 class="display d3 line-name">
                <a href={href(`/products/${p.slug}`, lang)}>{fa ? p.fa : p.en}</a>
              </h3>
              <p class="counter sm">
                <bdi lang={counterLang} dir={counterDir}>{fa ? p.en : p.fa}</bdi>
              </p>

              <dl class="kv">
                <div>
                  <dt>{t('label.origin', lang)}</dt>
                  <dd>{fa ? p.originFa : p.origin}</dd>
                </div>
                <div>
                  <dt>{t('label.grade', lang)}</dt>
                  <dd>{fa ? p.gradeFa : p.grade}</dd>
                </div>
                <div>
                  <dt>{t('label.format', lang)}</dt>
                  <dd>
                    <bdi dir="ltr">{p.formats.join(' · ')}</bdi>
                  </dd>
                </div>
              </dl>

              <a class="inline-cta" href={href(`/products/${p.slug}`, lang)}>
                {t('cta.line', lang)}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4.5 12h15" />
                  <path d="m13 5.5 6.5 6.5-6.5 6.5" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="all-link">
      <a class="inline-cta" href={href('/products', lang)}>
        {t('cta.all', lang)}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4.5 12h15"></path>
          <path d="m13 5.5 6.5 6.5-6.5 6.5"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<!-- ========================= WHAT WE DO ========================= -->
<section class="sec do">
  <div class="wrap do-in">
    <div class="do-copy">
      <p class="label kick"><i aria-hidden="true"></i>{t('home.do.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('home.do.h1', lang)}<br /><span class="acc">{t('home.do.h2', lang)}</span>
      </h2>
      <p class="lede">{t('home.do.p', lang)}</p>
      <p class="do-cta">
        <a class="inline-cta" href={href('/about', lang)}>
          {t('cta.about', lang)}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4.5 12h15"></path>
            <path d="m13 5.5 6.5 6.5-6.5 6.5"></path>
          </svg>
        </a>
      </p>
    </div>

    <ol class="flow">
      {
        FLOW.map((f, i) => (
          <li>
            <span class="fn">{digits(String(i + 1).padStart(2, '0'), lang)}</span>
            <span class="ft">{t(f.t, lang)}</span>
            <span class="fb">{t(f.b, lang)}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ========================== ORIGINS =========================== -->
<section class="sec origins">
  <div class="wrap">
    <div class="sec-head">
      <p class="label kick"><i aria-hidden="true"></i>{t('origins.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('origins.h1', lang)}<br /><span class="acc">{t('origins.h2', lang)}</span>
      </h2>
      <p class="lede">{t('origins.p', lang)}</p>
    </div>

    <ul class="ogrid">
      {
        ORIGINS.map((o) => (
          <li class="ocity">
            <span class="oc display">{fa ? o.fa : o.en}</span>
            <span class="of">
              <bdi lang={counterLang} dir={counterDir}>{fa ? o.en : o.fa}</bdi>
            </span>
            <span class="op">{fa ? o.pFa : o.pEn}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ========================== CLOSING =========================== -->
<section class="close">
  <img
    class="close-bg"
    src="/assets/band.webp"
    width="2400"
    height="1000"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="wrap">
    {/* The measure lives on this inner block, never on .wrap — .wrap carries
        margin-inline:auto, so narrowing it centres the column instead of holding
        it on the reading edge. */}
    <div class="close-in">
      <p class="label kick"><i aria-hidden="true"></i>{t('close.k', lang)}</p>
      <h2 class="display d2 sec-h">
        {t('close.h1', lang)} <span class="acc">{t('close.h2', lang)}</span>
      </h2>
      <p class="lede close-lede">{t('close.p', lang)}</p>
      <div class="ctas">
        <a class="btn" href={href('/contact', lang)}>{t('cta.quote', lang)}</a>
        <a class="btn ghost" href={href('/products', lang)}>{t('cta.all', lang)}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }

  /* ---------------------------------------------------------------- shared */
  .sec {
    padding-block: var(--rhythm);
  }

  .sec-head {
    max-inline-size: 62ch;
    margin-block-end: clamp(40px, 4.6vw, 66px);
  }
  .sec-h {
    margin-block-start: 20px;
  }
  .sec-head .lede {
    margin-block-start: 22px;
  }

  /* A hairline that belongs to the label, drawn in solid gold. Gold is only ever used
     at full opacity here — at 75-80% it drops to 4.09:1 on obsidian and fails. */
  .kick i {
    display: block;
    inline-size: 26px;
    block-size: 1px;
    background: currentColor;
    flex: none;
  }

  /* girih rule: a gold hairline broken by three khatam diamonds */
  .grule {
    display: flex;
    align-items: center;
    gap: 11px;
    max-inline-size: 320px;
    margin-block-start: 26px;
  }
  .grule::before,
  .grule::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background: var(--hair-strong);
  }
  .grule i {
    inline-size: 5px;
    block-size: 5px;
    background: var(--gold);
    transform: rotate(45deg);
    flex: none;
  }
  .grule i:nth-child(2) {
    inline-size: 8px;
    block-size: 8px;
  }

  /* the counter-script echo — Persian under English, Latin under Persian */
  .counter {
    margin: 16px 0 0;
    font-family: var(--font-fa);
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    font-weight: 400;
    line-height: 1.8;
    color: var(--gold-light);
  }
  :global(html[lang='fa']) .counter {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .counter.sm {
    font-size: 1.05rem;
    margin-block-start: 6px;
    line-height: 1.6;
  }

  /* ---------------------------------------------------------------- arch */
  .arch {
    margin: 0;
    position: relative;
    isolation: isolate;
  }
  .arch-in {
    position: relative;
    overflow: hidden;
    background: var(--obsidian-700);
    clip-path: url(#pgArch);
  }
  /* Absolutely positioned inside a fixed-ratio frame. In normal flow height:100%
     cannot resolve against a flex-sized parent and the image drives the row height. */
  .arch-in img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
    transition: transform 1.1s var(--ease);
  }
  .arch-in::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(12, 11, 10, 0.24) 0%,
      rgba(12, 11, 10, 0) 38%,
      rgba(12, 11, 10, 0.34) 100%
    );
  }
  .arch-line {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    z-index: 2;
  }
  .arch-line path {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  /* ---------------------------------------------------------------- buttons */
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-block-start: 36px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 15px 28px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--obsidian-deep);
    background: var(--gold);
    border: 1px solid var(--gold);
    transition: color 0.4s var(--snap);
  }
  :global(html[lang='fa']) .btn {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--obsidian-deep);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--snap);
  }
  .btn:hover::after {
    transform: scaleY(1);
  }
  .btn:hover {
    color: var(--gold);
  }
  .btn.ghost {
    background: transparent;
    color: var(--ivory);
  }
  .btn.ghost::after {
    background: var(--gold);
  }
  .btn.ghost:hover {
    color: var(--obsidian-deep);
  }

  .inline-cta {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    padding-block: 6px;
    border-block-end: 1px solid var(--hair-strong);
    transition: color 0.3s var(--snap), border-color 0.3s var(--snap);
  }
  :global(html[lang='fa']) .inline-cta {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .inline-cta:hover {
    color: var(--gold-pale);
    border-block-end-color: var(--gold);
  }
  .inline-cta svg {
    inline-size: 15px;
    block-size: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  :global(html[dir='rtl']) .inline-cta svg {
    transform: scaleX(-1);
  }

  /* ---------------------------------------------------------------- hero */
  .hero {
    padding-block: clamp(44px, 6vw, 88px) clamp(52px, 7vw, 100px);
    overflow: hidden;
  }
  .hero-in {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-in {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(48px, 5vw, 84px);
    }
  }
  .hero-h1 {
    margin-block-start: 22px;
  }
  .hero-lede {
    margin-block-start: 24px;
  }
  .hero-arch {
    inline-size: min(340px, 78vw);
    margin-inline: auto;
  }
  .hero-arch .arch-in {
    aspect-ratio: 3 / 4.3;
  }
  @media (min-width: 900px) {
    .hero-arch {
      inline-size: min(420px, 100%);
      margin-inline: 0;
    }
  }

  /* ---------------------------------------------------------------- stats */
  .stats {
    border-block: 1px solid var(--hair);
    background: var(--surface);
  }
  .stats-in {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .stats-in {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .stats-in {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .stat {
    display: grid;
    gap: 10px;
    padding-block: clamp(26px, 3vw, 40px);
    padding-inline-end: 20px;
    border-block-start: 1px solid var(--hair-ivory);
  }
  .stats-in .stat:nth-child(1),
  .stats-in .stat:nth-child(2) {
    border-block-start: 0;
  }
  @media (min-width: 640px) {
    .stats-in .stat:nth-child(3) {
      border-block-start: 0;
    }
  }
  @media (min-width: 1000px) {
    .stat {
      border-block-start: 0;
    }
  }
  .sv {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 3.1rem);
    font-weight: 600;
    line-height: 1;
    color: var(--gold-light);
  }
  :global(html[lang='fa']) .sv {
    font-family: var(--font-fa);
    font-weight: 600;
  }
  .sl {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  :global(html[lang='fa']) .sl {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }

  /* ------------------------------------------------------- shipping today */
  .now-grid {
    display: grid;
    gap: clamp(30px, 3.4vw, 44px);
  }
  @media (min-width: 900px) {
    .now-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .line {
    display: grid;
    gap: 26px;
    align-content: start;
    padding: clamp(22px, 2.4vw, 32px);
    border: 1px solid var(--hair);
    background: var(--surface);
    transition: border-color 0.4s var(--snap), background-color 0.4s var(--snap);
  }
  @media (min-width: 560px) {
    .line {
      grid-template-columns: 190px minmax(0, 1fr);
      gap: clamp(24px, 2.6vw, 36px);
      align-items: start;
    }
  }
  .line:hover {
    border-color: var(--hair-strong);
    background: var(--obsidian-900);
  }
  .line:hover .arch-in img {
    transform: scale(1.045);
  }

  .line-fig {
    display: block;
    position: relative;
    inline-size: min(190px, 60%);
  }
  @media (min-width: 560px) {
    .line-fig {
      inline-size: 100%;
    }
  }
  .line-fig .arch-in {
    aspect-ratio: 3 / 4;
  }

  .line-body {
    min-inline-size: 0;
  }
  .line-name {
    margin: 14px 0 0;
  }
  .line-name a {
    transition: color 0.3s var(--snap);
  }
  .line-name a:hover {
    color: var(--gold-light);
  }

  .kv {
    margin: 22px 0 0;
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--hair-ivory);
  }
  .kv > div {
    display: grid;
    gap: 5px;
    padding-block: 13px;
    border-block-end: 1px solid var(--hair-ivory);
  }
  @media (min-width: 420px) {
    .kv > div {
      grid-template-columns: minmax(0, 11ch) minmax(0, 1fr);
      gap: 5px 18px;
      align-items: baseline;
    }
  }
  .kv dt {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(html[lang='fa']) .kv dt {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .kv dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text);
  }

  .line .inline-cta {
    margin-block-start: 22px;
  }

  .all-link {
    margin: clamp(34px, 4vw, 52px) 0 0;
  }

  /* -------------------------------------------------------------- tags */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 12px;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
    border: 1px solid var(--gold);
    color: var(--gold);
  }
  :global(html[lang='fa']) .tag {
    font-family: var(--font-fa);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  /* the only circle on the page — a status dot, per the radius rule */
  .tag i {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  /* -------------------------------------------------------------- what we do */
  .do {
    background: var(--surface);
