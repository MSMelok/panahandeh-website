---
/**
 * Logistics — consolidation, Incoterms, indicative transit.
 *
 * THE BUG THIS FILE EXISTS TO NOT REPEAT: a transit range is two numerals with an
 * en-dash between them. The en-dash is bidi-neutral, and inside a Persian
 * paragraph the Unicode algorithm resolves it to R, which lays the two numeral
 * runs out right-to-left. "3–7 days" then renders as "7–3" — seven to three days.
 * Every range, every axis tick, every Latin Incoterm code on this page is wrapped
 * in <bdi dir="ltr">, which isolates the run so its first strong type is the
 * isolate's own LTR direction and the numerals stay in written order.
 *
 * The bars are plotted against one shared 0–TRANSIT_MAX scale so the regions can be
 * compared; offset and length ride on inset-inline-start / inline-size, so in
 * Persian the axis starts at the right without a second stylesheet.
 */
import { INCOTERMS, TRANSIT, TRANSIT_MAX, SITE, type Lang } from '../../data/site';
import { t, href, digits } from '../../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fa = lang === 'fa';

const loads = [
  { code: 'FCL', name: t('l.cons.fcl', lang), body: t('l.cons.fcl.b', lang) },
  { code: 'LCL', name: t('l.cons.lcl', lang), body: t('l.cons.lcl.b', lang) },
  { code: null, name: t('l.cons.mix', lang), body: t('l.cons.mix.b', lang) },
];

/* INCOTERMS carries only an English place, and the only one set is Jebel Ali —
   so the Persian rendering takes the translated port name rather than transliterating. */
const terms = INCOTERMS.map((x) => ({
  code: x.code,
  place: x.place ? (fa ? t('l.jebelali', lang) : x.place) : null,
  gloss: fa ? x.fa : x.en,
}));

const rows = TRANSIT.map((r) => ({
  region: fa ? r.regionFa : r.region,
  range: `${digits(r.min, lang)}–${digits(r.max, lang)}`,
  start: (r.min / TRANSIT_MAX) * 100,
  width: ((r.max - r.min) / TRANSIT_MAX) * 100,
}));
---

<section class="pgh">
  <div class="wrap">
    <p class="label">{t('l.kicker', lang)}</p>
    <h1 class="display d1 pgh-h">
      {t('l.h1a', lang)} <span class="acc">{t('l.h1b', lang)}</span>
    </h1>
    <div class="grule" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="lede">{t('l.lede', lang)}</p>
  </div>
</section>

<!-- ===================== consolidation ===================== -->
<section class="sec" aria-labelledby="l-cons">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">{t('l.cons.k', lang)}</p>
      <h2 class="display d2" id="l-cons">{t('l.cons.h', lang)}</h2>
      <p class="lede">{t('l.cons.p', lang)}</p>
      {/* English takes the port straight off site.ts; Persian takes the translation. */}
      <p class="port">{fa ? t('l.port', lang) : SITE.port}</p>
    </header>

    <ul class="loads">
      {
        loads.map((l) => (
          <li class="load">
            {l.code ? (
              <p class="load-code">
                <bdi dir="ltr">{l.code}</bdi>
              </p>
            ) : (
              <p class="load-code load-code-dot" aria-hidden="true">
                <i />
              </p>
            )}
            <h3 class="load-name">{l.name}</h3>
            <p class="load-body">{l.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ===================== incoterms ===================== -->
<section class="sec sec-alt" aria-labelledby="l-terms">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">{t('l.terms.k', lang)}</p>
      <h2 class="display d2" id="l-terms">{t('l.terms.h', lang)}</h2>
      <p class="lede">{t('l.terms.p', lang)}</p>
    </header>

    <dl class="terms">
      {
        terms.map((x) => (
          <div class="term">
            <dt class="term-h">
              <span class="term-code">
                <bdi dir="ltr">{x.code}</bdi>
              </span>
              {x.place && <span class="term-place">{x.place}</span>}
            </dt>
            <dd class="term-b">{x.gloss}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- ===================== indicative transit ===================== -->
<section class="sec" aria-labelledby="l-transit">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">{t('transit.title', lang)}</p>
      <h2 class="display d2" id="l-transit">{t('l.transit.h', lang)}</h2>
      <p class="lede">{t('l.transit.p', lang)}</p>
    </header>

    <table class="transit">
      <caption class="transit-cap">{t('l.transit.scale', lang)}</caption>
      <thead>
        <tr>
          <th scope="col">{t('transit.region', lang)}</th>
          <th scope="col" class="th-bar">
            <span class="vh">{t('l.transit.scale', lang)}</span>
            {/* the two ticks sit at the ends of the same box the bars are drawn in,
                so the scale is read off the track itself */}
            <span class="axis" aria-hidden="true">
              <bdi dir="ltr">{digits(0, lang)}</bdi>
              <bdi dir="ltr">{digits(TRANSIT_MAX, lang)}</bdi>
            </span>
          </th>
          <th scope="col" class="th-days">{t('transit.days', lang)}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row" class="td-region">
                {r.region}
              </th>
              <td class="td-bar">
                <span class="track">
                  <span class="bar" style={`--s:${r.start}%;--w:${r.width}%`} />
                </span>
              </td>
              <td class="td-days">
                <bdi dir="ltr">{r.range}</bdi>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    {/* Not a footnote. A buyer who plans a landing date off this table and misses it
        is a buyer who does not come back, so the qualification is set at reading size
        directly under the numbers it qualifies. */}
    <aside class="note" aria-labelledby="l-note">
      <p class="label" id="l-note">{t('l.note.k', lang)}</p>
      <p class="note-b">{t('transit.note', lang)}</p>
    </aside>
  </div>
</section>

<!-- ===================== closing band ===================== -->
<section class="close">
  <div class="wrap close-in">
    <p class="label">{t('close.k', lang)}</p>
    <h2 class="display d2">
      {t('close.h1', lang)} <span class="acc">{t('close.h2', lang)}</span>
    </h2>
    <p class="lede">{t('close.p', lang)}</p>
    <a class="cta" href={href('/contact', lang)}>{t('cta.quote', lang)}</a>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------- shell */
  .pgh {
    padding-block: clamp(48px, 7vw, 92px) clamp(40px, 5vw, 68px);
    border-block-end: 1px solid var(--hair);
  }
  .pgh-h {
    margin-block-start: 18px;
    max-inline-size: 16ch;
  }
  .lede {
    margin-block: 0;
  }
  .pgh .lede {
    margin-block-start: 26px;
  }

  .grule {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-block-start: 30px;
    max-inline-size: 320px;
  }
  .grule::before,
  .grule::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background: var(--hair-strong);
  }
  .grule i {
    inline-size: 5px;
    block-size: 5px;
    background: var(--gold);
    transform: rotate(45deg);
    flex: none;
  }
  .grule i:nth-child(2) {
    inline-size: 8px;
    block-size: 8px;
  }

  .sec {
    padding-block: var(--rhythm);
  }
  .sec-alt {
    background: var(--surface);
  }
  .sec-head {
    display: grid;
    gap: 18px;
    max-inline-size: 64ch;
    margin-block-end: clamp(36px, 4.4vw, 58px);
  }
  .sec-head .display {
    margin: 0;
  }

  .port {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--accent);
  }
  :global(html[lang='fa']) .port {
    font-family: var(--font-fa);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
  }
  /* ---------------------------------------------------------------- loads */
  .loads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
  }
  @media (min-width: 760px) {
    .loads {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .load {
    background: var(--surface);
    padding: clamp(24px, 3vw, 34px) clamp(20px, 2.4vw, 30px) clamp(28px, 3.2vw, 38px);
    min-inline-size: 0;
  }
  .load-code {
    margin: 0 0 18px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1;
    color: var(--accent);
    min-block-size: 12px;
  }
  .load-code-dot i {
    display: block;
    inline-size: 6px;
    block-size: 6px;
    background: var(--gold);
    transform: rotate(45deg);
  }
  .load-name {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.42rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }
  .load-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-muted);
  }
  :global(html[lang='fa']) .load-name {
    font-family: var(--font-fa);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }

  /* ---------------------------------------------------------------- terms */
  .terms {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--hair);
  }
  .term {
    padding-block: clamp(20px, 2.4vw, 28px);
    border-block-end: 1px solid var(--hair);
    display: grid;
    gap: 10px;
  }
  @media (min-width: 860px) {
    .term {
      grid-template-columns: minmax(0, 16ch) minmax(0, 1fr);
      gap: 0 32px;
      align-items: baseline;
    }
  }
  .term-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    min-inline-size: 0;
  }
  .term-code {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent-strong);
  }
  .term-place {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(html[lang='fa']) .term-place {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .term-b {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--text-muted);
    max-inline-size: 62ch;
  }

  /* ---------------------------------------------------------------- transit */
  .transit {
    inline-size: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .transit-cap {
    text-align: start;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-dim);
    padding-block-end: 16px;
  }
  :global(html[lang='fa']) .transit-cap {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .transit th,
  .transit td {
    text-align: start;
    padding-block: 14px;
    border-block-end: 1px solid var(--hair);
    vertical-align: middle;
  }
  .transit thead th {
    padding-block-start: 0;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(html[lang='fa']) .transit thead th {
    font-family: var(--font-fa);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .transit thead th:first-child {
    inline-size: 32%;
  }
  .th-bar {
    inline-size: 44%;
    padding-inline: 14px;
  }
  .th-days,
  .td-days {
    inline-size: 24%;
    text-align: end;
    white-space: nowrap;
  }
  .td-region {
    font-weight: 400;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--text);
    padding-inline-end: 10px;
  }
  /* Cormorant defaults to old-style figures, which set 1 and 0 at x-height —
     "10–14" then reads as "ıo–ı4". A transit range is a specification value, so it
     asks for lining, tabular figures. */
  .td-days {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent-strong);
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: 'lnum' 1, 'tnum' 1;
  }
  :global(html[lang='fa']) .td-days {
    font-family: var(--font-fa);
    font-size: 1rem;
  }

  .td-bar {
    padding-inline: 14px;
  }
  /* the track is the full 0–TRANSIT_MAX scale; the bar is the region's slice of it */
  .track {
    display: block;
    position: relative;
    block-size: 6px;
    background: var(--hair);
  }
  .axis {
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }
  .bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--s);
    inline-size: var(--w);
    min-inline-size: 3px;
    background: var(--gold);
  }

  /* ---------------------------------------------------------------- note */
  .note {
    margin-block-start: clamp(26px, 3vw, 38px);
    background: var(--surface-raised);
    border-inline-start: 3px solid var(--gold);
    padding: clamp(22px, 2.8vw, 30px) clamp(20px, 2.6vw, 32px);
    display: grid;
    gap: 12px;
    max-inline-size: 78ch;
  }
  .note-b {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.75;
    color: var(--text);
  }

  /* ---------------------------------------------------------------- close */
  .close {
    background: var(--surface);
    border-block-start: 1px solid var(--hair);
    padding-block: var(--rhythm);
  }
  /* The measure goes on the children, never on .close-in itself: .close-in IS the
     .wrap, and .wrap carries margin-inline:auto — capping its width centres the
     whole block instead of holding it at the gutter. */
  .close-in {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .close-in .display {
    margin: 0;
    max-inline-size: 20ch;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-block-start: 14px;
    padding: 15px 28px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ivory);
    border: 1px solid var(--gold);
    transition: color 0.4s var(--snap);
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--snap);
  }
  .cta:hover::after {
    transform: scaleY(1);
  }
  .cta:hover {
    color: var(--obsidian-deep);
  }
  :global(html[lang='fa']) .cta {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }

  /* ---------------------------------------------------------------- narrow */
  /* Measured at 320: region 32% = 84px holds "Kingdom" on one line, the track keeps
     44% and the range column stays wide enough for a five-glyph Persian numeral. */
  @media (max-width: 460px) {
    .td-region {
      font-size: 13.5px;
    }
    .th-bar,
    .td-bar {
      padding-inline: 10px;
    }
    .td-days {
      font-size: 1rem;
    }
  }

  @media (pointer: coarse) {
    .cta {
      min-block-size: 48px;
    }
  }
</style>
