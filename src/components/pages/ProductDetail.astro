---
/**
 * Product detail.
 *
 * Content lives here once; /products/[slug] and /fa/products/[slug] are thin wrappers
 * that pass `lang` and the product record. These pages are the SEO argument for the
 * whole site, so each one carries real specification — grade, retail formats,
 * HS code, category and availability — rather than a paragraph of adjectives.
 *
 * Every numeral that sits inside Persian prose is isolated in <bdi dir="ltr">. Without
 * it the bidi algorithm reverses "8–9 mm" and draws an HS code back to front. Both
 * were real bugs in the previous build.
 */
import type { Lang } from '../../data/site';
import { PRODUCTS, type Product } from '../../data/products';
import { t, href, type Key } from '../../data/i18n';
import RavomaMark from '../RavomaMark.astro';
import Arch from '../ornament/Arch.astro';
import Ground from '../ornament/Ground.astro';

interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product: p } = Astro.props;
const fa = lang === 'fa';
/* Pick a per-language value. Written out rather than left as the `fa ? x : y`
   ternaries this replaced, because those silently yielded English for Arabic. */
const pick3 = <T,>(en: T, faV: T, ar: T): T => (lang === 'fa' ? faV : lang === 'ar' ? ar : en);
const counterLang = lang === 'en' ? 'fa' : 'en';
const counterDir = counterLang === 'fa' ? 'rtl' : 'ltr';

const CATEGORY: Record<Product['category'], Key> = {
  spices: 'cat.spices',
  grains: 'cat.grains',
  pulses: 'cat.pulses',
};

const name = pick3(p.en, p.fa, p.ar);
const counterName = (lang === 'en' ? p.fa : p.en);
const blurb = pick3(p.blurbEn, p.blurbFa, p.blurbAr);

/* Same category first, live lines before upcoming ones, four at most. */
const related = PRODUCTS.filter((x) => x.slug !== p.slug)
  .sort((a, b) => {
    const cat = Number(b.category === p.category) - Number(a.category === p.category);
    if (cat !== 0) return cat;
    return Number(b.live) - Number(a.live);
  })
  .slice(0, 4);
---

<article class="pd">
  <div class="wrap">
    <nav class="crumbs" aria-label={t('nav.products', lang)}>
      <a href={href('/products', lang)}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M19.5 12h-15"></path>
          <path d="m11 5.5-6.5 6.5 6.5 6.5"></path>
        </svg>
        {t('nav.products', lang)}
      </a>
    </nav>

    <div class="head">
      <Arch class="pd-arch">
        <img
          src={`/assets/${p.img}.webp`}
          width="900"
          height="1200"
          fetchpriority="high"
          decoding="async"
          alt={`${name} — ${pick3(p.grade, p.gradeFa, p.gradeAr)}`}
        />
      </Arch>

      <div class="head-copy">
        <p class="label kick"><i aria-hidden="true"></i>{t(CATEGORY[p.category], lang)}</p>

        <h1 class="display d2 pd-h1">{name}</h1>
        <p class="counter"><bdi lang={counterLang} dir={counterDir}>{counterName}</bdi></p>

        <p class={`tag ${p.live ? 'on' : 'off'}`}>
          <i aria-hidden="true"></i>
          {p.live ? t('status.live', lang) : t('status.soon', lang)}
        </p>

        <p class="lede pd-blurb">{blurb}</p>

        {
          p.slug === 'saffron' && (
            <div class="ravoma">
              <RavomaMark width={168} />
              <p>{t('pd.ravoma', lang)}</p>
            </div>
          )
        }

        <div class="ctas">
          <a class="btn" href={`${href('/contact', lang)}?product=${p.slug}`}>
            {t('cta.enquire', lang)}
          </a>
          <a class="btn ghost" href={href('/products', lang)}>{t('cta.all', lang)}</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================= SPECIFICATION ======================== -->
  <section class="sec spec has-ground" aria-labelledby="h-spec">
    <Ground kind="tile" />
    <div class="wrap spec-in">
      <div class="spec-table">
        <h2 class="display d3 spec-h" id="h-spec">{t('pd.spec', lang)}</h2>
        <table>
          <tbody>
            <tr>
              <th scope="row">{t('label.grade', lang)}</th>
              <td>{pick3(p.grade, p.gradeFa, p.gradeAr)}</td>
            </tr>
            <tr>
              <th scope="row">{t('label.format', lang)}</th>
              <td>
                <bdi dir="ltr">{p.formats.join(' · ')}</bdi>
              </td>
            </tr>
            <tr>
              <th scope="row">{t('label.hs', lang)}</th>
              <td>
                <bdi dir="ltr" class="mono hs">{p.hs}</bdi>
              </td>
            </tr>
            <tr>
              <th scope="row">{t('label.category', lang)}</th>
              <td>{t(CATEGORY[p.category], lang)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="avail">
        <h2 class="display d3 spec-h">{t('pd.availability', lang)}</h2>
        <p class={`tag ${p.live ? 'on' : 'off'}`}>
          <i aria-hidden="true"></i>
          {p.live ? t('status.live', lang) : t('status.soon', lang)}
        </p>
        <p class="avail-note">{p.live ? t('pd.live.note', lang) : t('pd.soon.note', lang)}</p>
        <a class="inline-cta" href={`${href('/contact', lang)}?product=${p.slug}`}>
          {t('cta.enquire', lang)}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4.5 12h15"></path>
            <path d="m13 5.5 6.5 6.5-6.5 6.5"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================== RELATED =========================== -->
  <section class="sec related has-ground" aria-labelledby="h-rel">
    <Ground kind="field" />
    <div class="wrap">
      <h2 class="display d2 rel-h" id="h-rel">{t('pd.related', lang)}</h2>

      <ul class="grid">
        {
          related.map((r) => (
            <li>
              <a class={`card-link${r.live ? '' : ' muted'}`} href={href(`/products/${r.slug}`, lang)}>
                <Arch as="span" muted={!r.live}>
                  <img
                    src={`/assets/${r.img}.webp`}
                    width="900"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                    alt=""
                  />
                </Arch>
                <span class="cbody">
                  <span class="cname display d3">{pick3(r.en, r.fa, r.ar)}</span>
                  <span class={`tag cardtag ${r.live ? 'on' : 'off'}`}>
                    <i aria-hidden="true" />
                    {r.live ? t('status.live', lang) : t('status.soon', lang)}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</article>

<style>
  .pd {
    padding-block-start: clamp(22px, 3vw, 36px);
  }

  .sec {
    padding-block: clamp(52px, 6.4vw, 92px);
  }
  .kick i {
    display: block;
    inline-size: 26px;
    block-size: 1px;
    background: currentColor;
    flex: none;
  }

  /* --------------------------------------------------------------- crumbs */
  .crumbs {
    margin-block-end: clamp(24px, 3vw, 40px);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-block: 6px;
    transition: color 0.3s var(--snap);
  }
  :global(html[lang='fa']) .crumbs a {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .crumbs a {
    font-family: var(--font-ar);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .crumbs a:hover {
    color: var(--accent-strong);
  }
  .crumbs svg {
    inline-size: 15px;
    block-size: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  :global(html[dir='rtl']) .crumbs svg {
    transform: scaleX(-1);
  }

  /* ---------------------------------------------------------------- head */
  .head {
    display: grid;
    gap: clamp(32px, 4vw, 54px);
    align-items: start;
  }
  @media (min-width: 860px) {
    .head {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(44px, 5vw, 76px);
    }
  }
  :global(.pd-arch) {
    inline-size: min(300px, 74vw);
    margin-inline: auto;
  }
  @media (min-width: 860px) {
    :global(.pd-arch) {
      inline-size: 100%;
      margin-inline: 0;
    }
  }
  .pd-h1 {
    margin-block-start: 20px;
  }
  .counter {
    margin: 10px 0 0;
    font-family: var(--font-fa);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 400;
    line-height: 1.8;
    color: var(--accent-strong);
  }
  :global(html[lang='fa']) .counter {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    line-height: 1.3;
  }
:global(html[lang='ar']) .counter {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    line-height: 1.3;
  }
  .pd-blurb {
    margin-block-start: 24px;
  }

  .ravoma {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 26px;
    margin-block-start: 28px;
    padding: 20px 24px;
    border: 1px solid var(--hair);
    background: var(--surface);
  }
  .ravoma p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* ---------------------------------------------------------------- tags */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 20px 0 0;
    padding: 6px 12px;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
    /* nowrap floors the card's min-content width and pushes the row off a 320px
       screen. Two short words are allowed to break. */
    white-space: normal;
  }
  :global(html[lang='fa']) .tag {
    font-family: var(--font-fa);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .tag {
    font-family: var(--font-ar);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .tag i {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    flex: none;
  }
  .tag.on {
    border: 1px solid var(--gold);
    color: var(--accent-strong);
  }
  .tag.on i {
    background: currentColor;
  }
  .tag.off {
    border: 1px dashed var(--hair-strong);
    color: var(--text-dim);
  }
  .tag.off i {
    background: transparent;
    border: 1px solid currentColor;
  }

  /* ---------------------------------------------------------------- ctas */
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-block-start: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 15px 28px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--obsidian-deep);
    background: var(--gold);
    border: 1px solid var(--gold);
    transition: color 0.4s var(--snap);
  }
  :global(html[lang='fa']) .btn {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .btn {
    font-family: var(--font-ar);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ground);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--snap);
  }
  .btn:hover::after {
    transform: scaleY(1);
  }
  .btn:hover {
    color: var(--accent-strong);
  }
  .btn.ghost {
    background: transparent;
    color: var(--text);
  }
  .btn.ghost::after {
    background: var(--gold);
  }
  .btn.ghost:hover {
    color: var(--obsidian-deep);
  }

  .inline-cta {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin-block-start: 24px;
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-strong);
    padding-block: 6px;
    border-block-end: 1px solid var(--hair-strong);
    transition: color 0.3s var(--snap), border-color 0.3s var(--snap);
  }
  :global(html[lang='fa']) .inline-cta {
    font-family: var(--font-fa);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .inline-cta {
    font-family: var(--font-ar);
    font-size: 13.5px;
    letter-spacing: 0;
    text-transform: none;
  }
  .inline-cta:hover {
    color: var(--accent-strong);
    border-block-end-color: var(--accent-strong);
  }
  .inline-cta svg {
    inline-size: 15px;
    block-size: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  :global(html[dir='rtl']) .inline-cta svg {
    transform: scaleX(-1);
  }

  /* --------------------------------------------------------------- spec */
  .spec {
    margin-block-start: clamp(52px, 6.4vw, 92px);
    background: var(--surface);
    border-block: 1px solid var(--hair);
  }
  .spec-in {
    display: grid;
    gap: clamp(36px, 4vw, 56px);
    align-items: start;
  }
  @media (min-width: 860px) {
    .spec-in {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: clamp(44px, 5vw, 76px);
    }
  }
  .spec-h {
    margin: 0 0 20px;
    color: var(--text);
  }

  .spec table {
    inline-size: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .spec th,
  .spec td {
    text-align: start;
    vertical-align: baseline;
    padding-block: 15px;
    border-block-end: 1px solid var(--hair-ivory);
  }
  .spec tr:first-child th,
  .spec tr:first-child td {
    border-block-start: 1px solid var(--hair-ivory);
  }
  .spec th {
    inline-size: 34%;
    padding-inline-end: 18px;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.8;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  :global(html[lang='fa']) .spec th {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .spec th {
    font-family: var(--font-ar);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .spec td {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .hs {
    font-size: var(--step--1);
    color: var(--accent-strong);
  }

  .avail {
    padding: clamp(22px, 2.6vw, 32px);
    border: 1px solid var(--hair);
    background: var(--ground);
  }
  .avail .tag {
    margin-block-start: 0;
  }
  .avail-note {
    margin: 18px 0 0;
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* ------------------------------------------------------------- related */
  .rel-h {
    margin: 0 0 clamp(26px, 3vw, 40px);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(22px, 2.4vw, 32px) clamp(18px, 2vw, 26px);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 380px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .card-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    block-size: 100%;
    padding: clamp(14px, 1.6vw, 18px);
    border: 1px solid var(--hair-ivory);
    background: var(--ground);
    transition: border-color 0.4s var(--snap);
  }
  .card-link:hover {
    border-color: var(--hair-strong);
  }
  .card-link:hover :global(.pg-arch-in img) {
    transform: scale(1.045);
  }
  .cbody {
    display: grid;
    justify-items: start;
    padding-block-start: 16px;
  }
  .cname {
    display: block;
    overflow-wrap: anywhere;
    color: var(--text);
    line-height: 1.2;
  }
  .cmeta {
    display: block;
    overflow-wrap: anywhere;
    margin-block-start: 8px;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  :global(html[lang='fa']) .cmeta {
    font-family: var(--font-fa);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
:global(html[lang='ar']) .cmeta {
    font-family: var(--font-ar);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }
  .cardtag {
    margin-block-start: 12px;
  }
  /* The desaturated photograph and dimmed keyline are the Arch `muted` prop. */
  .card-link.muted .cname {
    color: var(--text-muted);
  }
  .card-link.muted .cmeta {
    color: var(--text-dim);
  }

  @media (pointer: coarse) {
    .btn {
      min-block-size: 48px;
    }
    .inline-cta,
    .crumbs a {
      min-block-size: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::after {
      transition: none;
    }
  }
</style>
