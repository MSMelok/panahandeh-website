---
/** Persian about. Same component, `lang="fa"`. */
import Base from '../../layouts/Base.astro';
import About from '../../components/pages/About.astro';
import { t } from '../../data/i18n';

const lang = 'fa' as const;
---

<Base
  title={t('meta.about.title', lang)}
  description={t('meta.about.desc', lang)}
  lang={lang}
  path="/about"
  image="/assets/about.webp"
>
  <About lang={lang} />
</Base>
