---
import Base from '../layouts/Base.astro';
import Quality from '../components/pages/Quality.astro';
import { t } from '../data/i18n';
import { qualitySchema } from '../lib/pageSchema';
---

<Base
  title={t('meta.quality.title', 'en')}
  description={t('meta.quality.desc', 'en')}
  lang="en"
  path="/quality"
  schema={qualitySchema('en')}
>
  <Quality lang="en" />
</Base>
